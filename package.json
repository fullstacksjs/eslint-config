{
  "name": "@fullstacksjs/eslint-config",
  "version": "15.4.0",
  "description": "fullstacks eslint config",
  "license": "MIT",
  "author": "fullstacks <fullstacksjs@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstacksjs/eslint-config.git"
  },
  "files": [
    "src",
    "!src/**/tests",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/types/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "spell": "cspell ./* --no-progress",
    "test": "vp test run src",
    "check": "vp check",
    "lint": "eslint . --ext .js,.ts,.mjs,.cjs",
    "build": "vp pack",
    "prepare": "vp config",
    "check:rules": "node scripts/check-missing-rules.mjs"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/config-helpers": "0.7.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.13.0",
    "local-pkg": "1.2.1",
    "typescript-eslint": "8.72.1"
  },
  "devDependencies": {
    "@semantic-release/git": "11.0.1",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "cypress": ">=15",
    "eslint": ">=10.3.0",
    "prettier": ">=3",
    "react": ">=19",
    "tailwindcss": ">=3.3.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "cypress": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "packageManager": "npm@12.2.1"
}
