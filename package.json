{
  "name": "@fullstacksjs/eslint-config",
  "version": "11.3.1",
  "description": "fullstacks eslint config",
  "license": "MIT",
  "author": "fullstacks <fullstacksjs@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstacksjs/eslint-config.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "spell": "cspell ./* --no-progress",
    "test": "echo 0",
    "check": "vp check",
    "lint": "eslint . --ext .js,.ts,.mjs,.cjs",
    "build": "vp pack",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "vp config",
    "check:rules": "node scripts/check-missing-rules.mjs"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.18.3",
    "@eslint/compat": "2.1.0",
    "@next/eslint-plugin-next": "16.3.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/eslint-plugin": "1.6.27",
    "deepmerge": "4.3.1",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-cypress": "7.0.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-storybook": "10.5.7",
    "globals": "17.10.0",
    "local-pkg": "1.2.1",
    "typescript-eslint": "8.67.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/eslint": "9.6.1",
    "cspell": "10.0.1",
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "pinst": "3.0.0",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "storybook": "10.5.7",
    "typescript": "6.0.3",
    "vite-plus": "0.2.8",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "cypress": ">=15",
    "eslint": ">=10.3.0",
    "prettier": ">=3",
    "react": ">=19",
    "tailwindcss": ">=3.3.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "cypress": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "npm@12.0.2"
}
